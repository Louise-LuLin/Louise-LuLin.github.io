<aside id="colorlib-aside" role="complementary" class="border js-fullheight">
  <div class="text-center">
    <div class="author-img" style="background-image: url({{ site.profile_image | relative_url }});"></div>
    <h1 id="colorlib-logo"><a href="{{ '/' | relative_url }}">{{ site.first_name }} {{ site.last_name }}</a></h1>
    <span class="position">{{ site.position }}<br>
      <a href="{{ site.affiliation_url }}"><span class="c-muted">{{ site.affiliation }}</span></a>
    </span>
    <ul class="social-icons" aria-label="Links">
      <li><a href="mailto:{{ site.email }}" title="Email" aria-label="Email">
        <svg viewBox="0 0 24 24" width="20" height="20"><path d="M3 5h18v14H3z" fill="none" stroke="currentColor" stroke-width="2"/><path d="M3 6l9 7 9-7" fill="none" stroke="currentColor" stroke-width="2"/></svg></a></li>
      <li><a href="https://scholar.google.com/citations?user={{ site.scholar_userid }}" title="Google Scholar" aria-label="Google Scholar">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 3 1 9l11 6 9-4.9V17h2V9L12 3z"/><path d="M5 13.2V17c0 2.2 3.1 4 7 4s7-1.8 7-4v-3.8l-7 3.8-7-3.8z"/></svg></a></li>
      <li><a href="https://github.com/{{ site.github_username }}" title="GitHub" aria-label="GitHub">
        <svg viewBox="0 0 16 16" width="20" height="20" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg></a></li>
      <li><a href="https://x.com/{{ site.x_username }}" title="X (Twitter)" aria-label="X">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a></li>
      <li><a href="{{ site.cv_pdf | relative_url }}" class="cv-pill" title="Curriculum Vitae">CV</a></li>
    </ul>
  </div>

  <nav id="colorlib-main-menu">
    <div>
      <ul>
        {% assign nav_pages = site.pages | where: "nav", true | sort: "nav_order" %}
        {% for p in nav_pages %}
          <li{% if page.url == p.url %} class="active"{% endif %}><a href="{{ p.url | relative_url }}">{{ p.nav_title | default: p.title }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </nav>

  <div class="colorlib-footer">
    <p><small>
      &copy; {{ site.time | date: "%Y" }} {{ site.first_name }} {{ site.last_name }}<br>
      Last updated: {{ site.time | date: "%b %Y" }}<br>
      <!-- Link back to Colorlib can't be removed. Template is licensed under CC BY 3.0. -->
      <span class="credit">Template: <a href="https://colorlib.com" target="_blank">Colorlib</a></span>
      <!-- Link back to Colorlib can't be removed. Template is licensed under CC BY 3.0. -->
    </small></p>
  </div>
</aside>
