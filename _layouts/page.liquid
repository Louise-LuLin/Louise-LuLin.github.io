---
layout: default
---
<section class="colorlib-section" data-section="{{ page.title | slugify }}">
  <div class="colorlib-narrow-content">
    <div class="row">
      <div class="col-md-12 animate-box">
        <p><br></p>
        {% if page.heading_meta %}<span class="heading-meta">{{ page.heading_meta }}</span>{% endif %}
        <h2 class="colorlib-heading">{{ page.title }}</h2>
      </div>
    </div>
    <div class="row">
      <div class="col-md-12 page-content">
        {% if page.description %}<p class="page-description">{{ page.description }}</p>{% endif %}
        {{ content }}
      </div>
    </div>
    <p><br><br></p>
  </div>
</section>
