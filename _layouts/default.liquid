<!DOCTYPE HTML>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  {% assign page_title = site.title %}{% if page.title and page.url != "/" %}{% assign page_title = page.title | append: " | " | append: site.title %}{% endif %}
  {% assign page_desc = page.description | default: site.description %}
  <title>{{ page_title }}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{ page_desc }}">
  <meta name="keywords" content="{{ site.keywords }}">
  <meta name="author" content="{{ site.title }}">

  <!-- Open Graph / Twitter preview cards -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ page_title }}">
  <meta property="og:description" content="{{ page_desc }}">
  <meta property="og:url" content="{{ page.url | absolute_url }}">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:image" content="{{ site.profile_image | absolute_url }}">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ page_title }}">
  <meta name="twitter:description" content="{{ page_desc }}">
  <meta name="twitter:image" content="{{ site.profile_image | absolute_url }}">
  {% if site.x_username %}<meta name="twitter:creator" content="@{{ site.x_username }}">{% endif %}
  <link rel="canonical" href="{{ page.url | absolute_url }}">

  <link rel="icon" type="image/x-icon" href="{{ '/assets/img/favicon.ico' | relative_url }}">
  <link rel="icon" type="image/png" sizes="32x32" href="{{ '/assets/img/favicon-32.png' | relative_url }}">
  <link rel="apple-touch-icon" sizes="180x180" href="{{ '/assets/img/apple-touch-icon.png' | relative_url }}">

  <!-- Noto Sans + Noto Sans Symbols 2 (Google Fonts) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,400;0,700;1,400;1,700&family=Noto+Sans+Symbols+2&display=swap" rel="stylesheet">

  <!-- Animate.css -->
  <link rel="stylesheet" href="{{ '/css/animate.css' | relative_url }}">
  <!-- Icomoon Icon Fonts-->
  <link rel="stylesheet" href="{{ '/css/icomoon.css' | relative_url }}">
  <!-- Bootstrap  -->
  <link rel="stylesheet" href="{{ '/css/bootstrap.css' | relative_url }}">
  <!-- Theme style  -->
  <link rel="stylesheet" href="{{ '/css/style.css' | relative_url }}">
  <!-- Site overrides -->
  <link rel="stylesheet" href="{{ '/css/custom.css' | relative_url }}">

  <!-- Modernizr JS -->
  <script src="{{ '/js/modernizr-2.6.2.min.js' | relative_url }}"></script>
  <!--[if lt IE 9]>
  <script src="{{ '/js/respond.min.js' | relative_url }}"></script>
  <![endif]-->
</head>
<body>
<div id="colorlib-page">
  <div class="container-wrap">
    <a href="#" class="js-colorlib-nav-toggle colorlib-nav-toggle" data-toggle="collapse" data-target="#navbar" aria-expanded="false" aria-controls="navbar"><i></i></a>
    {% include aside.liquid %}

    <div id="colorlib-main">
      {{ content }}
    </div><!-- end:colorlib-main -->
  </div><!-- end:container-wrap -->
</div><!-- end:colorlib-page -->

<script src="{{ '/js/jquery.min.js' | relative_url }}"></script>
<script src="{{ '/js/jquery.easing.1.3.js' | relative_url }}"></script>
<script src="{{ '/js/bootstrap.min.js' | relative_url }}"></script>
<script src="{{ '/js/jquery.waypoints.min.js' | relative_url }}"></script>
<script src="{{ '/js/main.js' | relative_url }}"></script>
</body>
</html>
