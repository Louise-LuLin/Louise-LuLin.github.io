---
---
{%- comment -%}
Renders one bibliography entry in the template's publication style:
  Title (blue)
  Authors: supervised students underlined (listed in _data/coauthors.yml), Lu Lin in black
  Venue in italics, (ABBR YEAR) in red, then [Paper] [Code] links.
{%- endcomment -%}
<div class="pub-entry" id="{{ entry.key }}">
  <a class="pub-title"{% if entry.html %} href="{{ entry.html }}" target="_blank"{% endif %}><font color="blue">{{ entry.title }}</font></a><br>
  <span class="pub-authors">
  {%- assign n = entry.author_array | size -%}
  {%- for author in entry.author_array -%}
    {%- assign last_clean = author.last | remove: '*' | remove: '†' | remove: '¶' | remove: '^' -%}
    {%- assign first_clean = author.first | remove: '*' | remove: '†' | remove: '¶' | remove: '^' -%}
    {%- assign star = '' -%}
    {%- if author.last contains '*' or author.first contains '*' -%}{%- assign star = '*' -%}{%- endif -%}
    {%- assign is_self = false -%}
    {%- if site.scholar.last_name contains last_clean and site.scholar.first_name contains first_clean -%}{%- assign is_self = true -%}{%- endif -%}
    {%- assign student_url = nil -%}
    {%- assign is_student = false -%}
    {%- assign key = last_clean | downcase -%}
    {%- if site.data.coauthors[key] -%}
      {%- for co in site.data.coauthors[key] -%}
        {%- if co.firstname contains first_clean -%}
          {%- assign is_student = true -%}
          {%- assign student_url = co.url -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
    {%- if forloop.first == false -%}
      {%- if forloop.last and n > 1 %} and {% else %}, {% endif -%}
    {%- endif -%}
    {%- if is_self -%}
      <font color="black"><b>{{ first_clean }} {{ last_clean }}</b></font>{{ star }}
    {%- elsif is_student -%}
      {%- if student_url and student_url != '' -%}<a href="{{ student_url }}" target="_blank"><u>{{ first_clean }} {{ last_clean }}</u></a>{%- else -%}<u>{{ first_clean }} {{ last_clean }}</u>{%- endif -%}{{ star }}
    {%- else -%}
      {{ first_clean }} {{ last_clean }}{{ star }}
    {%- endif -%}
  {%- endfor -%}
  </span><br>
  {%- assign proceedings = 'inproceedings,incollection' | split: ',' -%}
  {%- if entry.type == 'article' -%}
    <em>{{ entry.journal }}</em>
  {%- elsif proceedings contains entry.type -%}
    <em>{{ entry.booktitle }}</em>
  {%- endif -%}
  {%- if entry.abbr %} (<font color="red">{{ entry.abbr }} {{ entry.year }}</font>){% endif %}
  {%- if entry.note %}, {{ entry.note }}{% endif %}
  <span class="pub-links">
    {%- if entry.html %} [<a href="{{ entry.html }}" target="_blank">Paper</a>]{% endif -%}
    {%- if entry.pdf %} [<a href="{% if entry.pdf contains '://' %}{{ entry.pdf }}{% else %}{{ entry.pdf | prepend: '/assets/pdf/' | relative_url }}{% endif %}" target="_blank">PDF</a>]{% endif -%}
    {%- if entry.code %} [<a href="{{ entry.code }}" target="_blank">Code</a>]{% endif -%}
    {%- if entry.slides %} [<a href="{{ entry.slides }}" target="_blank">Slides</a>]{% endif -%}
    {%- if entry.poster %} [<a href="{{ entry.poster }}" target="_blank">Poster</a>]{% endif -%}
    {%- if entry.website %} [<a href="{{ entry.website }}" target="_blank">Website</a>]{% endif -%}
  </span>
</div>
